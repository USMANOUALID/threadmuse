# ThreadMuse — environment variables
# Copy to `.env.local` and fill in values. NEXT_PUBLIC_* keys are exposed to the browser.

# ── Site ──────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Supabase ──────────────────────────────────────────────────
# Get these from your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="ey…"
# server-only; never expose to the browser
SUPABASE_SERVICE_ROLE_KEY="ey…"

# Public storage host (derived from NEXT_PUBLIC_SUPABASE_URL — set automatically
# from that, but we expose it so next.config can read it at build time).
# Leave blank if you only use signed URLs.
NEXT_PUBLIC_SUPABASE_STORAGE_HOST=""

# ── Stripe (Phase 6) ──────────────────────────────────────────
# Server-side secret key. Test mode in development, live in production.
STRIPE_SECRET_KEY=""
# Webhook signing secret from `stripe listen` (dev) or the dashboard endpoint
# (prod). REQUIRED — webhooks 400 without it.
STRIPE_WEBHOOK_SECRET=""
# Publishable key for any client-side Stripe.js usage (currently none — checkout
# sessions are server-redirected). Kept here for the upgrade flow's later
# Elements integration.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Optional: pin to a specific dashboard-configured price for the Pro tier so
# the app can build a checkout session without first listing all prices.
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_PRO_YEARLY=""

# ── Analytics (optional) ─────────────────────────────────────
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""

# ── AdSense (Phase 7, optional) ───────────────────────────────
NEXT_PUBLIC_ADSENSE_CLIENT=""
